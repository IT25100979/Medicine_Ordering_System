# ==============================================================================
# ONLINE PHARMACY SYSTEM - ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# ==============================================================================

# Backend Database Configuration (MySQL)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=medical_system_db
DB_USER=root
DB_PASSWORD=root123

# Server Port & Base URL
SERVER_PORT=8080
API_BASE_URL=http://localhost:8080/api/v1

# Security & JWT Configuration
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970337336763979244226452948404D6351
JWT_EXPIRATION_MS=86400000

# Demo Mode & Safety Flags
ENABLE_DEMO_LOGIN=true
DEMO_SESSION_EXPIRATION_HOURS=2

# File Upload Directories & Limits
UPLOAD_DIR_PRESCRIPTIONS=uploads/prescriptions
UPLOAD_DIR_AVATARS=uploads/avatars
MAX_FILE_SIZE_MB=10

# Frontend Configuration (Vite / React)
VITE_API_BASE_URL=http://localhost:8080
VITE_ENABLE_DEMO_LOGIN=true
VITE_APP_TITLE=MediOrder Pharmacy
